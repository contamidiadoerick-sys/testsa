local A=type(p.asset)=="table"and p.asset.Animations
if type(A)=="table"then for _,k in ipairs({"Idle","Walk"})do if typeof(A[k])=="Instance"then lista[#lista+1]=A[k]end end end
for _,a in ipairs(candidatas(c,p.asset,{p.nome,p.exibe}))do lista[#lista+1]=a end
local got
for i,anim in ipairs(lista)do
if i>6 then break end
pcall(function()CP:PreloadAsync({anim})end)
local okT,tr=pcall(function()return an:LoadAnimation(anim)end)
if okT and tr then
tr.Looped=true tr.Priority=Enum.AnimationPriority.Action
tr:Play(0)
local t0=os.clock()
while tr.Length<=0 and os.clock()-t0<4 do task.wait(.05)end
if tr.Length>0 then got=tr break end
pcall(function()tr:Stop()end)
end
end
if got then r.animator,r.track=an,got else r.bob=true end
end)
if not ok then warn("WxV 3D erro:",p.nome,err)end
end)
end
