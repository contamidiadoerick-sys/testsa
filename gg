r.model,r.base,r.ext,r.nome=c,c:GetPivot(),ext,p.nome
r.icon.Visible=false
local an=c:FindFirstChildWhichIsA("Animator",true)
if not an then
local ctl=c:FindFirstChildWhichIsA("Humanoid",true)or c:FindFirstChildWhichIsA("AnimationController",true)or N("AnimationController",c,{})
an=ctl:FindFirstChildOfClass("Animator")or N("Animator",ctl,{})
end
